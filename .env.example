# ==============================================================================
# ATLAS — Environment Configuration Template (.env.example)
# ==============================================================================
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.
# Copy this file to .env for local demonstration and development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cryptographic Identity & JWT Boundary (Required by JwtIdentityVerifier)
# ------------------------------------------------------------------------------
# In production, use your corporate OIDC issuer and strong 256-bit signing key.
# For local demonstration, the values below match pre-signed tokens in ui/demo_tokens.json.
ATLAS_AUTH_ISSUER=https://identity.atlas.example/issuer
ATLAS_AUTH_AUDIENCE=atlas-query-api
ATLAS_AUTH_HS256_SECRET=atlas-demo-secret-key-32-bytes-long-2026
ATLAS_AUTH_CLOCK_SKEW_SECONDS=30

# ------------------------------------------------------------------------------
# 2. Service Pipeline & Workspace
# ------------------------------------------------------------------------------
# Root directory containing data/raw/novastack and data/processed/novastack
ATLAS_WORKSPACE_ROOT=.

# ------------------------------------------------------------------------------
# 3. Resilience, Concurrency & Deadlines
# ------------------------------------------------------------------------------
# Production deadline is 30.0s. For cold CPU model startup, set to 120.0s if needed.
ATLAS_REQUEST_TIMEOUT_SECONDS=30.0
ATLAS_MAX_CONCURRENT_INFERENCES=2
ATLAS_ENABLE_CIRCUIT_BREAKER=true
ATLAS_CIRCUIT_FAILURE_THRESHOLD=5
ATLAS_CIRCUIT_COOLDOWN_SECONDS=60.0

# ------------------------------------------------------------------------------
# 4. Inference Engine Decoupling
# ------------------------------------------------------------------------------
# Options:
#   - inference_service  : Backend B (HTTP adapter pointing to Ollama/container on 8001)
#   - local_huggingface  : Backend A (in-process PyTorch CPU execution of google/gemma-3-1b-it)
#   - quantized_local    : Quantized local provider
ATLAS_INFERENCE_PROVIDER=inference_service
ATLAS_INFERENCE_SERVICE_URL=http://127.0.0.1:8001

# ------------------------------------------------------------------------------
# 5. Canary Routing Infrastructure (Held at 0.0% Standby)
# ------------------------------------------------------------------------------
ATLAS_CANARY_ENABLED=false
ATLAS_CANARY_TRAFFIC_PERCENTAGE=0.0
ATLAS_CANARY_TENANT_ALLOWLIST=TENANT-NOVASTACK
